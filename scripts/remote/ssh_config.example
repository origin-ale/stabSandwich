# SSH config entry for the remote simulation machine (Phase R).
# Copy into ~/.ssh/config and replace every <...> placeholder.
#
# `ssh carlos` goes through both jumps. With ControlMaster, the first connection
# asks for the three passwords; later ssh/fetch.sh calls reuse it with no prompt
# until it has been idle for ControlPersist.
#
#   ssh -fN carlos      # open the shared connection in the background
#   ssh -O check carlos # is it open?
#   ssh -O exit carlos  # close it at the end of the working session
#
# Claude sessions can't use this connection: the managed sandbox (Phase S)
# blocks ~/.ssh and Unix sockets.

Host carlos-jump1
    HostName <first jump host>
    User <user on jump 1>

Host carlos-jump2
    HostName <second jump host>
    User <user on jump 2>
    ProxyJump carlos-jump1

Host carlos
    HostName <target host, as seen from jump 2>
    User <user on the target>
    ProxyJump carlos-jump2
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 4h
    ServerAliveInterval 60
